# All optional. Copy to .env for local work. On Cloudflare, add the same names
# under Settings > Build > Build variables and secrets, then redeploy.

# Web3Forms access key (free, https://web3forms.com): enter info-ge@buz-cloud.com there,
# the key arrives by email. Quote requests then land in that inbox. The key is public by design.
# The live key is already in .env.production.
# Without a key the form falls back to opening the visitor's email app.
VITE_WEB3FORMS_KEY=

# Alternative to Web3Forms: any endpoint that accepts a JSON POST (Formspree, your own API...).
# Add its domain to connect-src in public/_headers, or the browser's security policy blocks it.
VITE_FORM_ENDPOINT=

# Final site address, no trailing slash, e.g. https://buztech.ge (already set in .env.production).
# Enables canonical link, og:url and og:image. No sitemap: the site is private (noindex).
VITE_SITE_URL=

# Cloudflare Web Analytics token (Cloudflare dashboard > Analytics & Logs > Web Analytics).
# Cookie-free visit statistics. The privacy text adapts automatically.
# The live token is already in .env.production. It only works on the address it was made for.
VITE_CF_ANALYTICS_TOKEN=
