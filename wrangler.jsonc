// Cloudflare Workers deploy settings for the buztech-website Worker.
// The site is static: `npm run build` writes every page into dist/, and `npx wrangler deploy`
// uploads that folder as-is. Keep this file: without it Wrangler "auto-configures" the project,
// adds the Cloudflare Vite plugin and rebuilds, which breaks the pre-render step (scripts/prerender.mjs).
{
  "name": "buztech-website",
  "compatibility_date": "2026-10-23",
  // Only "/" runs this script first: it sends a first visit to the visitor's language (worker/index.js).
  "main": "./worker/index.js",
  // The site lives at buztech.ge only. www.buztech.ge is attached too, and a Cloudflare redirect rule
  // sends it to buztech.ge. The workers.dev address and preview addresses are off: one address, no copies.
  "routes": [
    { "pattern": "buztech.ge", "custom_domain": true },
    { "pattern": "www.buztech.ge", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    // Unknown addresses get the nearest 404.html (dist/404.html, dist/en/404.html ...) with a 404 status.
    "not_found_handling": "404-page"
  }
}
