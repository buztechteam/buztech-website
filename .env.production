# Read by `vite build`, locally and on Cloudflare. A Cloudflare build variable with
# the same name overrides a value here. See .env.example for what each one does.

# Web3Forms access key. It is public by design: it only says which inbox gets the
# form (the one the key was created for) and it ships in the site's JavaScript
# either way.
VITE_WEB3FORMS_KEY=2c438e10-7d75-479f-9212-24f634746529

# The site's address: canonical links, og:url and the link-preview image need it.
# It also writes sitemap.xml (Georgian and English pages) and the robots.txt sitemap line.
VITE_SITE_URL=https://buztech.ge

# Cloudflare Web Analytics token, made for buztech.ge (it counts www.buztech.ge too).
# It only works on the address it was made for. Public by design too.
VITE_CF_ANALYTICS_TOKEN=aa4c7ee323634d50819ff53795f319e9
